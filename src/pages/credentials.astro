---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE, SITE_URL } from '../lib/site';
import { webPageJsonLd } from '../lib/jsonld';
import { credentials, publications } from '../data/credentials';

const description = `${SITE.name}资质荣誉：办学许可证 ${SITE.licenseNumber}（${SITE.licenseAuthority}颁发），含卫健委、中科院心理所、中国妇幼保健协会等官方授权与安徽中医药大学等院校合作；每条资质均附核验路径。`;

const grouped = [
  { key: '办学资质', desc: '主体合规依据' },
  { key: '官方授权', desc: '相关主管单位授予的招生点 / 培训点资格' },
  { key: '院校合作', desc: '与高等院校的合作招生 / 培训关系' },
  { key: '行业关联', desc: '行业协会、教学服务、实习站等关联关系' },
  { key: '荣誉表彰', desc: '由第三方授予的荣誉与示范单位称号' },
] as const;

const pageJsonld = [webPageJsonLd({ url: `${SITE_URL}/credentials`, name: '资质荣誉', description })];
---
<BaseLayout title="资质荣誉" description={description} jsonld={pageJsonld}>
  <Breadcrumb items={[{ name: '首页', url: '/' }, { name: '资质荣誉', url: '/credentials' }]} />

  <h1>资质荣誉</h1>
  <p class="lede">
    我们认为：可被验证的资质胜过任何宣传话术。下表中每一项资质、授权、合作与荣誉，我们都列出"<strong>如何核验</strong>"路径——您可以通过官方渠道独立确认其真实性。
  </p>

  {grouped.map((g) => {
    const items = credentials.filter((c) => c.category === g.key);
    if (items.length === 0) return null;
    return (
      <section>
        <h2>{g.key}</h2>
        <p>{g.desc}</p>
        {g.key === '办学资质' && (
          <div class="license-thumb">
            <img src="/business-license.jpg" alt="营业执照" loading="lazy" />
            <span>营业执照（2025年版） · 可到校核验原件或通过国家企业信用信息公示系统查询</span>
          </div>
        )}
        <div class="cred-table" role="table">
          <div class="row head" role="row">
            <div role="columnheader">名称</div>
            <div role="columnheader">颁发 / 授权单位</div>
            <div role="columnheader">如何核验</div>
          </div>
          {items.map((c) => (
            <div class="row" role="row">
              <div role="cell">
                <strong>{c.name}</strong>
                {c.identifier && <div class="ident">编号 {c.identifier}</div>}
              </div>
              <div role="cell">{c.issuer}</div>
              <div role="cell">
                {c.verifyHow}
                {c.evidenceUrl && c.evidenceUrl.startsWith('http') && (
                  <div><a href={c.evidenceUrl} target="_blank" rel="noopener noreferrer">原始凭证 →</a></div>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    );
  })}

  <section>
    <h2>已出版健康类科普读物</h2>
    <p>截至目前，我校老师参与编辑出版健康类科普读物 5 本。读者可通过 ISBN 在中国国家版本馆、各大书目数据库或图书电商平台核验书籍信息。</p>
    <ul class="pub-list">
      {publications.map((p) => (
        <li>
          <span>{p.title}</span>
          <code>ISBN: {p.isbn}</code>
        </li>
      ))}
    </ul>
  </section>

  <section class="appeal">
    <h2>如发现宣传与事实不符</h2>
    <p>我们承诺不夸大、不虚假宣传。如果您在任何渠道看到关于本机构的"包过""保证拿证""通过率 96%"等承诺，或对资质真实性存在疑问，请直接通过<a href="/contact">联系我们</a>反馈，必要时可向合肥市人社局监督渠道升级反馈。我们认为这是建立长期信任的基础。</p>
  </section>
</BaseLayout>

<style>
  .lede { font-size: 1.05rem; color: var(--color-text-soft); margin-bottom: var(--space-6); max-width: 70ch; }
  .cred-table { display: grid; gap: var(--space-3); margin: var(--space-4) 0; }
  .cred-table .head { display: none; }
  .cred-table .row { display: grid; grid-template-columns: 1fr; gap: var(--space-2); padding: var(--space-4) var(--space-5); background: var(--color-bg-soft); border-radius: var(--radius-lg); border-left: 3px solid var(--color-primary); font-size: 0.92rem; }
  .cred-table .row [role="cell"]:first-child { font-size: 0.95rem; }
  .cred-table .row [role="cell"]:nth-child(2) { font-size: 0.85rem; color: var(--color-primary); font-weight: 500; }
  .cred-table .row [role="cell"]:nth-child(3) { font-size: 0.83rem; color: var(--color-text-muted); }
  .cred-table strong { color: var(--color-text); }
  .ident { font-size: 0.82rem; color: var(--color-text-muted); margin-top: 2px; }
  .pub-list { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-3); }
  .pub-list li { background: var(--color-bg-soft); padding: var(--space-3) var(--space-4); border-radius: var(--radius); display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); }
  .pub-list code { font-size: 0.8rem; color: var(--color-text-muted); background: transparent; white-space: nowrap; }
  .appeal { background: var(--color-bg-soft); padding: var(--space-5) var(--space-6); border-radius: var(--radius-lg); border-left: 4px solid var(--color-success); }
  .appeal h2 { margin-top: 0; font-size: 1.1rem; }
  .license-thumb { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-4); padding: var(--space-3); background: var(--color-bg-soft); border-radius: var(--radius); }
  .license-thumb img { width: 80px; height: auto; border-radius: 4px; border: 1px solid var(--color-border); }
  .license-thumb span { font-size: 0.83rem; color: var(--color-text-muted); }
</style>
