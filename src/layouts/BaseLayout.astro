---
import { SITE } from '../lib/site';
import { organizationJsonLd } from '../lib/jsonld';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  jsonld?: object | object[];
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  injectOrgSchema?: boolean;
  narrow?: boolean;
}

const {
  title,
  description,
  canonical,
  jsonld,
  ogImage,
  ogType,
  noindex,
  injectOrgSchema = false,
  narrow = false,
} = Astro.props;

const pageJsonld = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
const finalJsonld = injectOrgSchema
  ? [organizationJsonLd(), ...pageJsonld]
  : pageJsonld;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#1a4a8c" />
    <link rel="icon" type="image/png" href={SITE.logo} />
    <link rel="apple-touch-icon" href={SITE.logo} />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      jsonld={finalJsonld}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <Header />
    <main id="main" class:list={['site-main', narrow && 'narrow']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
<style is:global>
  .skip-link { position: absolute; left: -9999px; top: auto; width: 1px; height: 1px; overflow: hidden; }
  .skip-link:focus { position: fixed; left: 16px; top: 16px; width: auto; height: auto; padding: 8px 16px; background: var(--color-primary); color: #fff; border-radius: 6px; z-index: 100; }
  .site-main { max-width: var(--max-width); margin: 0 auto; padding: var(--space-6) var(--space-5) var(--space-7); }
  .site-main.narrow { max-width: 820px; }
  @media (max-width: 640px) {
    .site-main { padding: var(--space-4) var(--space-4) var(--space-6); }
  }
</style>
