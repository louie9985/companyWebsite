---
import { SITE } from '../lib/site';
const year = new Date().getFullYear();
const hasPolice = SITE.beian.police !== '__POLICE_ICP__';
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="col col-brand">
      <img src={SITE.logo} alt={`${SITE.name}`} width="160" height="41" loading="lazy" />
      <p class="legal">{SITE.legalName}</p>
      <p class="addr">{SITE.address.full}</p>
    </div>
    <div class="col">
      <h4>关于我们</h4>
      <ul>
        <li><a href="/about">企业介绍</a></li>
        <li><a href="/team">师资团队</a></li>
        <li><a href="/credentials">资质荣誉</a></li>
      </ul>
    </div>
    <div class="col">
      <h4>透明承诺</h4>
      <ul>
        <li><a href="/refund-policy">退费政策</a></li>
        <li><a href="/service-commitment">服务承诺</a></li>
        <li><a href="/faq">常见问题</a></li>
      </ul>
    </div>
    <div class="col">
      <h4>联系我们</h4>
      <ul>
        <li>电话：<a href={`tel:${SITE.contact.tel}`}>{SITE.contact.tel}</a></li>
        <li>邮箱：<a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a></li>
        <li>微信：{SITE.contact.wechat}</li>
        <li>{SITE.contact.hours}</li>
      </ul>
    </div>
  </div>
  <div class="beian">
    <p>办学许可证编号：<strong>{SITE.licenseNumber}</strong>（{SITE.licenseAuthority} 颁发）</p>
    <p>
      © 2011-{year} {SITE.legalName} 版权所有
      ｜ <a href={SITE.beian.icpUrl} target="_blank" rel="noopener noreferrer">{SITE.beian.icp}</a>
      {hasPolice && <span> ｜ {SITE.beian.police}</span>}
    </p>
  </div>
</footer>
<style>
  .site-footer { background: var(--color-bg-soft); border-top: 1px solid var(--color-border); margin-top: var(--space-8); padding: var(--space-7) 0 var(--space-5); }
  .footer-inner { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--space-5); display: grid; grid-template-columns: 1.5fr 1fr 1fr 1.2fr; gap: var(--space-6); }
  .col h4 { font-size: 1rem; margin: 0 0 var(--space-3); color: var(--color-text); }
  .col ul { list-style: none; padding: 0; margin: 0; }
  .col li { font-size: 0.9rem; color: var(--color-text-muted); margin-bottom: var(--space-2); }
  .col a { color: var(--color-text-soft); text-decoration: none; }
  .col a:hover { color: var(--color-primary); }
  .col-brand img { height: 38px; width: auto; margin-bottom: var(--space-3); }
  .col-brand .legal { font-weight: 600; color: var(--color-text); margin: 0 0 var(--space-2); font-size: 0.95rem; }
  .col-brand .addr { font-size: 0.85rem; color: var(--color-text-muted); margin: 0; line-height: 1.6; }
  .beian { max-width: var(--max-width); margin: var(--space-6) auto 0; padding: var(--space-5) var(--space-5) 0; border-top: 1px solid var(--color-border); text-align: center; font-size: 0.85rem; color: var(--color-text-muted); }
  .beian p { margin: 0 0 var(--space-2); color: var(--color-text-muted); }
  .beian a { color: var(--color-text-muted); }
  @media (max-width: 768px) {
    .footer-inner { grid-template-columns: 1fr 1fr; }
    .col-brand { grid-column: 1 / -1; }
  }
</style>
