---
import { SITE } from '../lib/site';

const pathname = Astro.url.pathname;
const navItems = [
  { href: '/', label: '首页' },
  { href: '/about', label: '关于我们' },
  { href: '/courses', label: '课程项目' },
  { href: '/team', label: '师资团队' },
  { href: '/credentials', label: '资质荣誉' },
  { href: '/service-commitment', label: '服务承诺' },
  { href: '/refund-policy', label: '退费政策' },
  { href: '/faq', label: '常见问题' },
  { href: '/contact', label: '联系我们' },
];
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label={`${SITE.name}首页`}>
      <img src={SITE.logo} alt={`${SITE.name}标志`} width="140" height="36" fetchpriority="high" />
    </a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="导航菜单开关" />
    <label for="nav-toggle" class="nav-burger" aria-hidden="true">
      <span></span><span></span><span></span>
    </label>
    <nav class="site-nav" aria-label="主导航">
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
<style>
  .site-header { background: #fff; border-bottom: 1px solid var(--color-border); position: sticky; top: 0; z-index: 50; }
  .header-inner { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--space-5); display: flex; align-items: center; justify-content: space-between; height: 64px; }
  .brand img { height: 36px; width: auto; }
  .site-nav ul { list-style: none; display: flex; gap: var(--space-2); margin: 0; padding: 0; }
  .site-nav a { display: inline-block; padding: 8px 12px; color: var(--color-text-soft); border-radius: 6px; font-size: 0.95rem; transition: background .15s, color .15s; text-decoration: none; }
  .site-nav a:hover { background: var(--color-primary-light); color: var(--color-primary); }
  .site-nav a[aria-current="page"] { color: var(--color-primary); background: var(--color-primary-light); font-weight: 600; }
  .nav-toggle, .nav-burger { display: none; }
  @media (max-width: 960px) {
    .nav-burger { display: flex; flex-direction: column; gap: 4px; cursor: pointer; padding: 8px; width: 40px; height: 40px; justify-content: center; align-items: center; }
    .nav-burger span { width: 22px; height: 2px; background: var(--color-text); display: block; }
    .site-nav { position: absolute; top: 64px; left: 0; right: 0; background: #fff; border-bottom: 1px solid var(--color-border); transform: translateY(-150%); transition: transform .25s; }
    .site-nav ul { flex-direction: column; padding: var(--space-3) var(--space-5); gap: 0; }
    .site-nav a { display: block; padding: 12px 0; }
    .nav-toggle:checked ~ .site-nav { transform: translateY(0); }
  }
</style>
